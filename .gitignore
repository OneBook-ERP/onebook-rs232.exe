# Waybridge Agent .gitignore

# Configuration files (may contain sensitive data)
# config.json is the template - keep it in git
# config.local.json is for local overrides - exclude it
config.local.json
*.json.bak

# Log files
*.log
*.log.*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# PyInstaller
# Keep .spec files for building
build/
dist/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Backup files
*.bak
*.backup
*.old

# OS
Thumbs.db
desktop.ini
